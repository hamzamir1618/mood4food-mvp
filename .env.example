NEO4J_URI=bolt://localhost:7687
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
REDIS_URL=redis://localhost:6379/0

# Get a free API key at console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change_me_before_deploying

# Signs login tokens. Generate the same way, and use a different value from SESSION_SECRET.
AUTH_SECRET=change_me_before_deploying
# Set to true when the app is served over HTTPS, so the login cookie is never sent over plain HTTP.
AUTH_COOKIE_SECURE=false

# ── Deployment ──────────────────────────────────────────────────────────────
# Origins allowed to call the API with credentials, comma separated. When the app
# and the API share an origin (the Docker image serves both), this only needs that
# one origin. A split deployment also needs the cookie's SameSite relaxed, so
# prefer keeping them together.
FRONTEND_ORIGIN=http://localhost:8000,http://localhost:5173

# full: audio and image input, and the Groq intent extractor.
# lite: text only, keyword extractor, no Groq quota spent.
# test: as lite, for the test suite.
DEPLOY_MODE=full

# Overrides the extractor that DEPLOY_MODE would choose: groq or keyword.
# Set this to keyword to keep a public link from spending the daily Groq allowance.
# INTENT_EXTRACTOR=keyword

# Guards against filling a free-tier graph. Sized for AuraDB Free; see docs/ACCOUNTS.md.
GRAPH_NODE_LIMIT=50000
GRAPH_RELATIONSHIP_LIMIT=175000
